const fs = require('fs');
const fetch = require('node-fetch');
const FormData = require('form-data');

const VT_API_KEY = process.env.VT_API_KEY;

async function scanWithVirusTotal(filePath) {
  if (!VT_API_KEY) return { provider: 'none', skipped: true };

  const form = new FormData();
  form.append('file', fs.createReadStream(filePath));

  const res = await fetch('https://www.virustotal.com/api/v3/files', {
    method: 'POST',
    headers: { 'x-apikey': VT_API_KEY },
    body: form
  });

  if (!res.ok) {
    const txt = await res.text();
    throw new Error('VT upload failed: ' + txt);
  }

  const json = await res.json();
  const id = json.data.id;

  for (let i = 0; i < 20; i++) {
    await new Promise(r => setTimeout(r, 3000));
    const r2 = await fetch(`https://www.virustotal.com/api/v3/analyses/${id}`, {
      headers: { 'x-apikey': VT_API_KEY }
    });
    const j2 = await r2.json();
    if (j2.data?.attributes?.status === 'completed') {
      const stats = j2.data.attributes.stats;
      return { provider: 'virustotal', stats, raw: j2 };
    }
  }

  return { provider: 'virustotal', stats: null, raw: null };
}

async function smartScan(filePath) {
  return await scanWithVirusTotal(filePath);
}

module.exports = { smartScan };
const AWS = require('aws-sdk');
const fs = require('fs');
const App = require('../models/App');
const { smartScan } = require('../utils/virusScan');

const s3 = new AWS.S3({
  accessKeyId: process.env.AWS_ACCESS_KEY_ID,
  secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY,
  region: process.env.AWS_REGION
});

async function uploadFileToS3(file) {
  const fileContent = fs.readFileSync(file.path);
  const params = {
    Bucket: process.env.AWS_BUCKET_NAME,
    Key: `${Date.now()}-${file.originalname.replace(/\s+/g,'_')}`,
    Body: fileContent,
    ContentType: file.mimetype,
    ACL: 'public-read'
  };
  const data = await s3.upload(params).promise();
  return data.Location;
}

async function uploadApp(req, res) {
  try {
    const { name, description, category, coverUrl } = req.body;
    const file = req.file;
    if (!file) return res.status(400).json({ message: 'File required' });

    const scan = await smartScan(file.path);
    if (scan.stats?.malicious > 0) {
      fs.unlinkSync(file.path);
      return res.status(400).json({ message: 'File flagged as malicious', scan });
    }

    const fileUrl = await uploadFileToS3(file);

    const newApp = new App({
      name,
      description,
      category,
      coverUrl: coverUrl || '',
      files: [{ name: file.originalname, url: fileUrl, size: file.size }],
      owner: req.user._id,
      published: false,
      downloads: 0,
      stats: { downloadsHistory: [] }
    });

    await newApp.save();
    fs.unlinkSync(file.path);
    res.json({ message: 'Uploaded (pending publish)', app: newApp, scan });

  } catch (err) {
    res.status(500).json({ message: err.message });
  }
}

module.exports = { uploadApp };
